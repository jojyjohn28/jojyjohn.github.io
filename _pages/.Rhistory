show_rownames = FALSE,
fontsize_col = 7,
gaps_row = cumsum(table(df_sorted$mag_num)),
annotation_row = ann_row,
annotation_colors = ann_colors,
color = colorRampPalette(c("navy", "white", "firebrick3"))(100)
)
