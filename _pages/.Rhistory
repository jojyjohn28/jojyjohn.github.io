############################################################
## 1. Load packages
############################################################
library(readxl)
library(dplyr)
library(pheatmap)
library(RColorBrewer)
############################################################
## 2. Read file
############################################################
df <- read_excel("/home/jojy-john/Desktop/Dinu/co_metabolism/Burk_co_metabolism.xlsx")
# Check columns
colnames(df)
############################################################
## 3. Drop the all-NA column ("Unnamed: 62") if present
############################################################
# Remove columns that are completely NA
df <- df[, colSums(!is.na(df)) > 0]
############################################################
## 4. Define metadata vs count columns
############################################################
meta_cols <- c("MAGs", "Order", "Category", "gene.name")
# Use ONLY RNA columns as counts
count_cols <- grep("RNA", colnames(df), value = TRUE)
length(count_cols)  # should be 60 RNA columns
############################################################
## 5. Make sure counts are numeric
############################################################
df[count_cols] <- lapply(df[count_cols], function(x) as.numeric(as.character(x)))
# Safety: there should be no NAs now; if any, set them to 0
df[count_cols][is.na(df[count_cols])] <- 0
############################################################
## 6. Create unique gene IDs
############################################################
# gene.name can be NA; turn NAs into "NA" string so paste works
gene_label <- ifelse(is.na(df$gene.name), "NA", df$gene.name)
df$gene_id_raw <- paste(df$MAGs, df$Category, gene_label, sep = "|")
df$gene_id     <- make.unique(df$gene_id_raw)
rownames(df) <- df$gene_id
############################################################
## 7. Log2 normalization (instead of VST)
############################################################
mat <- as.matrix(df[, count_cols])
mode(mat) <- "numeric"
# log2(count + 1)
mat_log2 <- log2(mat + 1)
rownames(mat_log2) <- df$gene_id
############################################################
## 8. Extract MAG number & set Category order
############################################################
# MAG number from "Burkholderiales_MAG_12" → 12
df$MAG_num <- as.numeric(sub(".*_MAG_", "", df$MAGs))
# Category factor with all relevant levels
df$Category <- factor(
df$Category,
levels = c("Hydrocarbon degradation",
"C1 metabolism",
"Complex carbon degradation",
"Fermentation",
"Central carbon metabolism")
)
############################################################
## 9. Order rows: by MAG number, then Category
############################################################
ord <- order(df$MAG_num, df$Category)
# Load packages
library(ggplot2)
library(ggpubr)
library(ggsignif)
# Data
df <- data.frame(
Day = factor(c("14th day", "14th day", "24th day", "24th day"),
levels = c("14th day", "24th day")),
Treatment = factor(c("Control", "Steel Slag", "Control", "Steel Slag"),
levels = c("Control", "Steel Slag")),
Mean = c(2.833133333, 1.281066667, 0.229266667, 0.079233333),
SD   = c(0.649741203, 0.271001041, 0.007359650, 0.024046922)
)
# Base plot
p <- ggplot(df, aes(x = Treatment, y = Mean, fill = Day)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.8),
width = 0.7, color="black") +
geom_errorbar(aes(ymin = Mean - SD, ymax = Mean + SD),
width = 0.2,
position = position_dodge(width = 0.8)) +
labs(
y = "Protein concentration (per mg protein)",
x = "",
title = "Total Protein"
) +
scale_fill_manual(values = c("#1F4E79", "#F29F05")) +
theme_bw(base_size = 14) +
theme(
plot.title = element_text(hjust = 0.5, size = 18, face = "bold"),
axis.text = element_text(size = 14),
axis.title = element_text(size = 15),
legend.title = element_blank(),
legend.position = "top"
)
# Add significance brackets
p_sig <- p +
geom_signif(
annotations = c("***", "***"),
y_position = c(3.4, 1.6),
xmin = c(1 - 0.2, 2 - 0.2),
xmax = c(1 + 0.2, 2 + 0.2),
tip_length = 0.02,
textsize = 6
)
# Print
print(p_sig)
