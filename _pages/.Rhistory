df[[col]] <- gsub("[^0-9]", "", as.character(df[[col]]))
df[[col]][df[[col]] == ""] <- "0"
df[[col]] <- as.numeric(df[[col]])
}
sum(is.na(df[count_cols]))
which(is.na(df[count_cols]), arr.ind=TRUE)[1:20,]
library(readxl)
library(dplyr)
library(tidyr)
library(pheatmap)
library(RColorBrewer)
############################################################
# 1. Load + Clean
############################################################
df <- read_excel("/home/jojy-john/Desktop/Dinu/co_metabolism/Burk_co_metabolism.xlsx")
names(df) <- tolower(gsub(" ", "_", names(df)))
meta_cols  <- c("mags","order","category","gene.name")
count_cols <- setdiff(names(df), meta_cols)
# convert sample columns to numeric
df[count_cols] <- lapply(df[count_cols], function(x){
x <- gsub("[^0-9]", "", as.character(x))
x[x==""] <- "0"
as.numeric(x)
})
############################################################
# 2. Unique Gene IDs
############################################################
df$gene_id_raw <- paste(df$mags, df$category, df$gene.name, sep="|")
df$gene_id <- make.unique(df$gene_id_raw)
rownames(df) <- df$gene_id
############################################################
# 3. Log2 Normalization (instead of VST)
############################################################
mat <- as.matrix(df[, count_cols])
mat_log2 <- log2(mat + 1)
############################################################
# 4. Extract MAG number
############################################################
df$mag_num <- as.numeric(sub(".*_mag_", "", tolower(df$mags)))
############################################################
# 5. Fix Category factor
############################################################
all_levels <- c(
"Hydrocarbon degradation",
"C1 metabolism",
"Complex carbon degradation",
"Fermentation",
"Central carbon metabolism"
)
df$category <- factor(df$category, levels = all_levels)
############################################################
# 6. Order rows for heatmap
############################################################
order_rows <- order(df$mag_num, df$category)
mat_sorted <- mat_log2[order_rows, ]
df_sorted  <- df[order_rows, ]
############################################################
# 7. Annotation dataframe
############################################################
ann_row <- data.frame(
MAG      = factor(df_sorted$mag_num),
Category = df_sorted$category
)
rownames(ann_row) <- rownames(mat_sorted)
# MAG colors
mag_levels <- unique(ann_row$MAG)
mag_colors <- setNames(
colorRampPalette(brewer.pal(12,"Set3"))(length(mag_levels)),
mag_levels
)
# Category colors (including missing ones)
cat_colors <- c(
"Hydrocarbon degradation"    = "#e31a1c",
"C1 metabolism"              = "#1f78b4",
"Complex carbon degradation" = "#33a02c",
"Fermentation"               = "#ff7f00",
"Central carbon metabolism"  = "#000000"
)
# keep ONLY categories present in your heatmap
cat_colors <- cat_colors[names(cat_colors) %in% unique(ann_row$Category)]
ann_colors <- list(
MAG = mag_colors,
Category = cat_colors
)
############################################################
# 9. Plot Heatmap
############################################################
pheatmap(
mat_sorted,
scale = "row",
cluster_rows = FALSE,
cluster_cols = TRUE,
show_rownames = FALSE,
fontsize_col = 7,
gaps_row = cumsum(table(df_sorted$mag_num)),
annotation_row = ann_row,
annotation_colors = ann_colors,
color = colorRampPalette(c("navy","white","firebrick3"))(100)
)
library(readxl)
library(dplyr)
library(tidyr)
library(pheatmap)
library(RColorBrewer)
# -----------------------------------------------------------
# 1. LOAD FILE
# -----------------------------------------------------------
df <- read_excel("/home/jojy-john/Desktop/Dinu/co_metabolism/Burk_co_metabolism.xlsx")
# -----------------------------------------------------------
# 2. CLEAN COLUMN NAMES
# -----------------------------------------------------------
names(df) <- tolower(gsub(" ", "_", names(df)))
# Drop last garbage column ("Unnamed: 62")
df <- df[, !grepl("unnamed", names(df))]
# -----------------------------------------------------------
# 3. DEFINE METADATA + COUNT COLUMNS
# -----------------------------------------------------------
meta_cols  <- c("mags", "order", "category", "gene.name")
count_cols <- setdiff(names(df), meta_cols)
# -----------------------------------------------------------
# 4. CLEAN NUMERIC COLUMNS (fix NA coercion)
# -----------------------------------------------------------
df[count_cols] <- lapply(df[count_cols], function(x) {
x <- gsub("[^0-9]", "", as.character(x))  # keep digits only
x[x == ""] <- "0"
as.numeric(x)
})
# -----------------------------------------------------------
# 5. LOG2 NORMALIZATION (no DESeq2)
# -----------------------------------------------------------
mat <- as.matrix(df[, count_cols])
mat_log2 <- log2(mat + 1)
# -----------------------------------------------------------
# 6. EXTRACT MAG NUMBER (e.g., MAG_12 → 12)
# -----------------------------------------------------------
df$mag_num <- as.numeric(sub(".*_mag_", "", tolower(df$mags)))
# -----------------------------------------------------------
# 7. FIX CATEGORY ORDER (ADD CENTRAL CARBON)
# -----------------------------------------------------------
df$category <- factor(df$category,
levels = c("Hydrocarbon degradation",
"C1 metabolism",
"Complex carbon degradation",
"Fermentation",
"Central carbon metabolism"))
# -----------------------------------------------------------
# 8. ROW ORDERING: MAG → Category
# -----------------------------------------------------------
row_order <- order(df$mag_num, df$category)
mat_sorted <- mat_log2[row_order, ]
df_sorted  <- df[row_order, ]
# -----------------------------------------------------------
# 9. BUILD ROW ANNOTATION (MAG + CATEGORY)
# -----------------------------------------------------------
ann_row <- data.frame(
MAG      = factor(df_sorted$mag_num),
Category = df_sorted$category
)
rownames(ann_row) <- rownames(mat_sorted)
# MAG colors
mag_levels  <- levels(ann_row$MAG)
mag_colors  <- setNames(
colorRampPalette(brewer.pal(12, "Set3"))(length(mag_levels)),
mag_levels
)
# Category colors
cat_colors <- c(
"Hydrocarbon degradation"    = "#e31a1c",
"C1 metabolism"              = "#1f78b4",
"Complex carbon degradation" = "#33a02c",
"Fermentation"               = "#ff7f00",
"Central carbon metabolism"  = "black"
)
ann_colors <- list(
MAG = mag_colors,
Category = cat_colors
)
# -----------------------------------------------------------
# 11. HEATMAP
# -----------------------------------------------------------
pheatmap(
mat_sorted,
scale = "row",
cluster_rows = FALSE,
cluster_cols = TRUE,
show_rownames = FALSE,
fontsize_col = 7,
gaps_row = cumsum(table(df_sorted$mag_num)),
annotation_row = ann_row,
annotation_colors = ann_colors,
color = colorRampPalette(c("navy", "white", "firebrick3"))(100)
)
library(dplyr)
library(DESeq2)
library(tidyr)
library(ggplot2)
library(pheatmap)
df <- read_excel("/home/jojy-john/Desktop/Dinu/co_metabolism/De_seq_co-metabolism.xlsx")
# Extract Order
df$Order <- sub("_MAG.*", "", df$MAGS)
# Create NON-UNIQUE gene_id (temporary)
df$gene_id_raw <- paste(df$MAGS, df$Category, df$Gene.name, sep="|")
# Make gene_id UNIQUE by adding .1 .2 .3...
df$gene_id <- make.unique(df$gene_id_raw)
# Assign rownames (unique now)
rownames(df) <- df$gene_id
count_cols <- df %>%
select(where(is.numeric)) %>%
colnames()
gene_counts <- as.matrix(df[, count_cols])
mode(gene_counts) <- "integer"
rownames(gene_counts) <- df$gene_id
dds <- DESeqDataSetFromMatrix(
countData = gene_counts,
colData   = data.frame(row.names = colnames(gene_counts)),
design = ~1
)
dds <- estimateSizeFactors(dds)
vsd <- varianceStabilizingTransformation(dds, blind = TRUE)
vst_mat <- assay(vsd)
# Check that rownames exist
rownames(vst_mat)[1:10]
dup <- duplicated(vst_mat)
cat("Duplicated expression rows removed:", sum(dup), "\n")
vst_mat_clean <- vst_mat[!dup, ]
meta_clean <- df[rownames(vst_mat_clean), c("Order","Category")]
# Remove zero-variance rows
var_rows <- apply(vst_mat_clean, 1, var)
vst_mat_clean2 <- vst_mat_clean[var_rows > 0, ]
meta_clean2 <- meta_clean[var_rows > 0, ]
pheatmap(
vst_mat_clean,
scale = "row",
cluster_rows = TRUE,
cluster_cols = TRUE,
show_rownames = FALSE,
fontsize_col = 6,
color = colorRampPalette(c("navy", "white", "firebrick3"))(100)
)
# Convert to factors
meta_clean$Order <- factor(meta_clean$Order)
meta_clean$Category <- factor(meta_clean$Category,
levels = c("Hydrocarbon degradation",
"C1 metabolism",
"Complex carbon degradation",
"Fermentation")
)
# Annotation colors
ann_colors <- list(
Order = setNames(rainbow(length(levels(meta_clean$Order))),
levels(meta_clean$Order)),
Category = c(
"Hydrocarbon degradation"    = "#e31a1c",
"C1 metabolism"              = "#1f78b4",
"Complex carbon degradation" = "#33a02c",
"Fermentation"               = "#ff7f00"
)
)
pheatmap(
vst_mat_clean,
scale = "row",
cluster_rows = TRUE,
cluster_cols = TRUE,
show_rownames = FALSE,
fontsize_col = 6,
annotation_row = meta_clean,
annotation_colors = ann_colors,
color = colorRampPalette(c("navy", "white", "firebrick3"))(100)
)
vst_df <- as.data.frame(vst_mat_clean)
vst_df$gene_id <- rownames(vst_mat_clean)
vst_long <- vst_df %>%
pivot_longer(
cols = -gene_id,
names_to = "Sample",
values_to = "Expression"
) %>%
left_join(meta_clean %>% mutate(gene_id = rownames(meta_clean)),
by = "gene_id")
agg_df <- vst_long %>%
group_by(Order, Category) %>%
summarise(
mean_expr = mean(Expression, na.rm = TRUE),
.groups = "drop"
)
ggplot(agg_df, aes(x = Order, y = Category)) +
geom_point(aes(size = mean_expr, color = mean_expr), alpha = 0.8) +
scale_size_continuous(name = "Mean expression (VST)") +
scale_color_gradient(low="navy", high="firebrick3", name="Expression") +
theme_bw() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, size=10),
axis.text.y = element_text(size=10),
panel.grid = element_line(color="grey90")
) +
labs(
x = "MAG Order",
y = "Carbon Metabolism Category",
title = "Co-metabolism Expression Patterns"
)
# Load packages
library(ggplot2)
library(ggpubr)
df <- data.frame(
Day = factor(c("14th day", "14th day", "24th day", "24th day"),
levels = c("14th day", "24th day")),
Treatment = factor(c("Control", "Steel Slag", "Control", "Steel Slag"),
levels = c("Control", "Steel Slag")),
Mean = c(2.833133333, 1.281066667, 0.229266667, 0.079233333),
SD   = c(0.649741203, 0.271001041, 0.007359650, 0.024046922)
)
p <- ggplot(df, aes(x = Treatment, y = Mean, fill = Day)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.8),
width = 0.7, color="black") +
geom_errorbar(aes(ymin = Mean - SD, ymax = Mean + SD),
width = 0.2,
position = position_dodge(width = 0.8)) +
labs(
y = "Protein concentration (per mg protein)",
x = "",
title = "Total Protein"
) +
scale_fill_manual(values = c("#1F4E79", "#F29F05")) +   # navy + orange like your figure
theme_bw(base_size = 14) +
theme(
plot.title = element_text(hjust = 0.5, size = 18, face = "bold"),
axis.text = element_text(size = 14),
axis.title = element_text(size = 15),
legend.title = element_blank(),
legend.position = "top"
)
p_sig <- p +
geom_signif(
annotations = c("***", "***"),
y_position = c(3.4, 1.7),     # adjust height of bracket
xmin = c(0.8, 1.8),
xmax = c(1.2, 2.2),
tip_length = 0.02,
textsize = 6
)
ggsave("Protein_concentration_plot.tiff", p_sig, width = 7, height = 5, dpi = 300)
ggsave("Protein_concentration_plot.png",  p_sig, width = 7, height = 5, dpi = 300)
# Print plot
p_sig
# Print plot
p_sig
p
